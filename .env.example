# Copy to .env (never committed) and adjust.
POSTGRES_USER=tariff
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tariff
API_PORT=8000
POSTGRES_HOST_PORT=55433

# Airflow (B19), used only with `docker compose --profile airflow ...`. Generate your own values.
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_FERNET_KEY=generate-a-urlsafe-base64-32-byte-key
AIRFLOW_WEBSERVER_SECRET_KEY=change-me
# Database the DAG tasks read and write (default: the B19 scratch clone, never the primary).
AIRFLOW_TARIFF_DB=tariff_b19_scratch
AIRFLOW_PORT=8080
